          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source"
      ],
      "title": "FieldAnnotation",
      "type": "object"
    },
    "FieldEvidence": {
      "additionalProperties": false,
      "description": "Visual/text grounding added after a form has been rendered or reviewed.",
