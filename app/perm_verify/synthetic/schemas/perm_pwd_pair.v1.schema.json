    "FieldAnnotation": {
      "additionalProperties": false,
      "description": "Sidecar metadata keyed by a canonical form-data path.",
      "properties": {
        "state": {
          "default": "present",
          "enum": [
            "present",
            "blank",
            "not_applicable",
            "unreadable",
            "not_found",
            "conflicting"
          ],
